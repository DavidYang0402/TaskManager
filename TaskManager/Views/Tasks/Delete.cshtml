@model TaskManager.ViewModels.DeleteTaskViewModel

@{
    ViewData["Title"] = "刪除任務";
}

<div class="container d-flex justify-content-center mt-5">
    <div class="card p-4 shadow-lg text-center" style="width: 500px;">
        <h2 class="text-danger"><i class="bi bi-exclamation-triangle"></i> 確定要刪除嗎?</h2>
        <hr />

        <h4 class="text-dark">@Model.Title</h4>
        <p class="text-muted">@Model.Description</p>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">刪除</button>
            <a asp-action="Index" class="btn btn-outline-secondary">返回列表</a>
        </form>
    </div>
</div>
