@model TaskManager.ViewModels.EditTaskViewModel

@{
    ViewData["Title"] = "編輯任務";
}

<div class="container d-flex justify-content-center mt-5">
    <div class="card p-4 shadow-lg" style="width: 500px;">
        <h2 class="text-center mb-4">編輯任務</h2>

        <form asp-action="Edit" method="post">
            <div class="form-group mb-3">
                <label asp-for="Title"><i class="bi bi-pencil-square"></i> 標題</label>
                <input asp-for="Title" class="form-control" placeholder="輸入任務標題" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description"><i class="bi bi-file-text"></i> 描述</label>
                <textarea asp-for="Description" class="form-control" placeholder="輸入任務描述"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Status"><i class="bi bi-list-task"></i> 狀態</label>
                <select asp-for="Status" class="form-control">
                    <option value="待辦">待辦</option>
                    <option value="進行中">進行中</option>
                    <option value="完成">完成</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-warning w-100">更新</button>

            <div class="text-center mt-3">
                <a asp-action="Index" class="btn btn-outline-secondary">返回列表</a>
            </div>
        </form>
    </div>
</div>
