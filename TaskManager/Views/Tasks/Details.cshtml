@model TaskManager.ViewModels.TaskViewModel

@{
    ViewData["Title"] = "任務詳情";
}

<div class="container d-flex justify-content-center mt-5">
    <div class="card p-4 shadow-lg" style="width: 500px;">
        <h2 class="text-center mb-4">@Model.Title</h2>
        <hr />

        <dl class="row">
            <dt class="col-sm-4"><i class="bi bi-file-text"></i> 描述</dt>
            <dd class="col-sm-8">@Model.Description</dd>

            <dt class="col-sm-4"><i class="bi bi-list-task"></i> 狀態</dt>
            <dd class="col-sm-8">
                <span class="badge bg-info">@Model.Status</span>
            </dd>
        </dl>

        <div class="text-center">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">編輯</a>
            <a asp-action="Index" class="btn btn-outline-secondary">返回列表</a>
        </div>
    </div>
</div>
