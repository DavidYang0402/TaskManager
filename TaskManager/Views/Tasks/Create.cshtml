@model TaskManager.ViewModels.CreateTaskViewModel

@{
    ViewData["Title"] = "建立任務";
}

<div class="container d-flex justify-content-center mt-5">
    <div class="card p-4 shadow-lg" style="width: 500px;">
        <h2 class="text-center mb-4">建立任務</h2>

        <form asp-action="Create">
            <div class="form-group mb-3">
                <label asp-for="Title"><i class="bi bi-pencil"></i> 標題</label>
                <input asp-for="Title" class="form-control" placeholder="輸入任務標題" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description"><i class="bi bi-file-text"></i> 描述</label>
                <textarea asp-for="Description" class="form-control" placeholder="輸入任務描述"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">建立</button>
        </form>

        <div class="text-center mt-3">
            <a asp-action="Index" class="btn btn-outline-secondary">返回列表</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
