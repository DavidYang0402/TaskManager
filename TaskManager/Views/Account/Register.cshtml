@model TaskManager.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "註冊";
}

<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="card p-4 shadow-lg" style="width: 400px;">
        <h2 class="text-center mb-4">註冊</h2>

        <form asp-action="Register" method="post">
            <div class="form-group mb-3">
                <label asp-for="UserName"><i class="bi bi-person"></i> 使用者名稱</label>
                <input asp-for="UserName" class="form-control" placeholder="請輸入使用者名稱" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FullName"><i class="bi bi-person-circle"></i> 全名</label>
                <input asp-for="FullName" class="form-control" placeholder="請輸入全名" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email"><i class="bi bi-envelope"></i> 電子郵件</label>
                <input asp-for="Email" class="form-control" placeholder="請輸入電子郵件" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password"><i class="bi bi-lock"></i> 密碼</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="A-Z + a-z + 0-9 + symbols" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ConfirmPassword"><i class="bi bi-lock-fill"></i> 確認密碼</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="請再次輸入密碼" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">註冊</button>

            <div class="text-center mt-3">
                <p>已有帳號? <a href="@Url.Action("Login", "Account")">點此登入</a></p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
